# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real credentials.

# The contact form POSTs a JSON body ({ name, email, subject, message }) to
# this URL and expects a 2xx response on success. A free Formspree endpoint
# (https://formspree.io) works out of the box with this shape — create a
# form there and paste its endpoint URL below. Any other service that
# accepts a JSON POST and returns 200 will also work.
VITE_CONTACT_FORM_ENDPOINT=
